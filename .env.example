# Kopyalayin: cp .env.example .env — ve degerleri doldurun.
# .env dosyasi .gitignore'dadir, depoya gitmez.
#
# ⚠️ Portainer stack'leri .env dosyasi OKUMAZ. Portainer kullaniyorsaniz ayni degiskenleri
#    Stacks → Environment variables bolumune elle girin.

# --- Operator hesabi ---------------------------------------------------------------------
# Ilk aciliste olusturulur. Bos birakilirsa rastgele bir parola uretilip loga BIR KEZ yazilir.
# ⚠️ Parola sifirlama akisi yoktur. Kaydedin.
ADMIN_EMAIL=admin@marmaracloud.net
ADMIN_PASSWORD=

# --- Genel adres -------------------------------------------------------------------------
# Telefonun bagladigi adresle birebir ayni olmali — sema dahil. CORS bunu kullanir.
PUBLIC_ORIGIN=https://izleme.marmaracloud.net

# --- Port baglama ------------------------------------------------------------------------
# Nginx Proxy Manager ayni sunucuda KONTEYNER olarak kosuyorsa: bu sunucunun LAN IP'si.
#   NPM → Proxy Host → Forward Hostname/IP: ayni IP, Forward Port: 5199
# 127.0.0.1 birakirsaniz NPM konteynerinden ulasilamaz ve 502 alirsiniz.
BIND_ADDRESS=192.168.2.240
