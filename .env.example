# Kopyalayin: cp .env.example .env — ve degerleri doldurun.
# .env dosyasi .gitignore'dadir, depoya gitmez.
#
# ⚠️ Portainer stack'leri .env dosyasi OKUMAZ. Portainer kullaniyorsaniz ayni degiskenleri
#    Stacks → Environment variables bolumune elle girin.

# --- Operator hesabi ---------------------------------------------------------------------
# Ilk aciliste olusturulur. Bos birakilirsa rastgele bir parola uretilip loga BIR KEZ yazilir.
ADMIN_EMAIL=admin@marmaracloud.net
ADMIN_PASSWORD=

# --- Genel adres -------------------------------------------------------------------------
# Telefonun bagladigi adresle birebir ayni olmali — sema dahil. CORS bunu kullanir.
PUBLIC_ORIGIN=https://izleme.marmaracloud.net

# --- Port baglama ------------------------------------------------------------------------
# nginx AYNI sunucuda   → 127.0.0.1
# nginx BASKA sunucuda  → bu sunucunun ozel IP'si (0.0.0.0 degil), + guvenlik duvari kurali:
#                           ufw allow from <nginx-ip> to any port 5199 proto tcp
#                           ufw deny 5199
# nginx ayni Docker agindaysa → ports blogunu kullanmayin, networks kullanin
BIND_ADDRESS=127.0.0.1

# --- Agent ------------------------------------------------------------------------------
# Bu sureden uzun sessiz kalan agent icin kritik alarm uretilir.
AGENT_OFFLINE_MINUTES=3

# --- Agent tarafi (docker-compose.agent.yml icin, MUSTERI sunucusunda) --------------------
# HUB_URL=https://izleme.marmaracloud.net
# ENROLLMENT_KEY=arayuzden-uretilen-anahtar
